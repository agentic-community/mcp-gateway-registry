  "tool_mappings": [
    {
      "tool_name": "echo",
      "alias": "ev_echo",
      "backend_server_path": "/everything/"
    },
    {
      "tool_name": "get-sum",
      "backend_server_path": "/everything/"
    },
    {
      "tool_name": "get-header-params",
      "backend_server_path": "/everything/"
    },
    {
      "tool_name": "get-structured-content",
      "backend_server_path": "/everything/"
    },
    {
      "tool_name": "get-annotated-message",
      "backend_server_path": "/everything/"
    },
    {
      "tool_name": "trigger-long-running-operation",
      "backend_server_path": "/everything/"
    },
    {
      "tool_name": "echo",
      "alias": "ping_echo",
      "backend_server_path": "/pingmcp/"
    }
  ],
  "required_scopes": [],
  "tool_scope_overrides": [],
  "tags": [
    "mcp",
    "testing",
    "protocol",
    "compatibility"
  ],
  "supported_transports": [
    "streamable-http"
  ],
