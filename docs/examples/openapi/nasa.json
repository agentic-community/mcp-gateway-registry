{
  "openapi": "3.0.3",
  "info": {
    "title": "NASA Open APIs (subset)",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.nasa.gov"
    }
  ],
  "paths": {
    "/planetary/apod": {
      "get": {
        "operationId": "getApod",
        "tags": [
          "apod"
        ],
        "summary": "Astronomy Picture of the Day",
        "parameters": [
          {
            "name": "date",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "Date of the picture, YYYY-MM-DD. Defaults to today."
          }
        ],
        "responses": {
          "200": {
            "description": "The picture's title, explanation and URL"
          }
        }
      }
    },
    "/mars-photos/api/v1/rovers/{rover}/photos": {
      "get": {
        "operationId": "getMarsRoverPhotos",
        "tags": [
          "mars"
        ],
        "summary": "Photos from a Mars rover",
        "parameters": [
          {
            "name": "rover",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Rover name, for example curiosity"
          },
          {
            "name": "sol",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            },
            "description": "Martian sol (day) the photos were taken"
          }
        ],
        "responses": {
          "200": {
            "description": "Photos taken on that sol"
          }
        }
      }
    },
    "/neo/rest/v1/feed": {
      "get": {
        "operationId": "getNeoFeed",
        "tags": [
          "neo"
        ],
        "summary": "Near-Earth objects (asteroids) by date range",
        "parameters": [
          {
            "name": "start_date",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "First day, YYYY-MM-DD"
          },
          {
            "name": "end_date",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "Last day, YYYY-MM-DD, at most 7 days after start_date"
          }
        ],
        "responses": {
          "200": {
            "description": "Asteroids approaching Earth in that range"
          }
        }
      }
    }
  }
}
