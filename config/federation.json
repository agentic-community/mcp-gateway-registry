{
  "anthropic": {
    "enabled": true,
    "endpoint": "https://registry.modelcontextprotocol.io",
    "api_version": "v0.1",
    "servers": [
      {
        "name": "ai.smithery/smithery-ai-github",
        "requires_auth": true,
        "auth_type": "api-key",
        "auth_env_var": "SMITHERY_API_KEY",
        "enabled": true,
        "metadata": {
          "description": "GitHub API access - file operations, repository management, search",
          "category": "development"
        }
      },
      {
        "name": "ai.smithery/Hint-Services-obsidian-github-mcp",
        "requires_auth": true,
        "auth_type": "api-key",
        "auth_env_var": "SMITHERY_API_KEY",
        "enabled": true,
        "metadata": {
          "description": "GitHub-hosted Obsidian vault integration for AI assistants",
          "category": "productivity"
        }
      },
      {
        "name": "io.github.jgador/websharp",
        "requires_auth": false,
        "enabled": true,
        "metadata": {
          "description": "Web search and article text extraction for LLMs",
          "category": "search"
        }
      },
      {
        "name": "ai.smithery/data-mindset-sts-google-forms-mcp",
        "requires_auth": true,
        "auth_type": "api-key",
        "auth_env_var": "SMITHERY_API_KEY",
        "enabled": true,
        "metadata": {
          "description": "Google Forms management - create surveys and collect data",
          "category": "productivity"
        }
      },
      {
        "name": "ai.smithery/saidsef-mcp-github-pr-issue-analyser",
        "requires_auth": true,
        "auth_type": "api-key",
        "auth_env_var": "SMITHERY_API_KEY",
        "enabled": true,
        "metadata": {
          "description": "Automated GitHub PR and issue analysis",
          "category": "development"
        }
      },
      {
        "name": "ai.shawndurrani/mcp-merchant",
        "requires_auth": false,
        "enabled": true,
        "metadata": {
          "description": "Search-only commerce MCP server backed by Stripe (test)",
          "category": "commerce"
        }
      }
    ],
    "cache_ttl_seconds": 3600,
    "sync_interval_seconds": 300,
    "sync_on_startup": true,
    "display_options": {
      "mark_as_federated": true,
      "attribution_label": "Anthropic MCP Registry",
      "separate_section": true,
      "read_only": true
    },
    "timeout_seconds": 30,
    "retry_attempts": 3
  },
  "asor": {
    "enabled": false,
    "endpoint": "https://wcpdev.wd103.myworkday.com/awsasor_wcpdev1/api/asor/v1",
    "agents": [],
    "cache_ttl_seconds": 3600,
    "sync_interval_seconds": 300,
    "sync_on_startup": true,
    "display_options": {
      "mark_as_federated": true,
      "attribution_label": "Workday ASOR",
      "separate_section": true,
      "read_only": true
    },
    "auth_type": "oauth2",
    "auth_env_var": "ASOR_CLIENT_CREDENTIALS",
    "timeout_seconds": 30,
    "retry_attempts": 3
  }
}
